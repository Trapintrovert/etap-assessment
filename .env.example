# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=etap
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Paystack (get from https://dashboard.paystack.com)
PAYSTACK_API_KEY=

# Transfer (amount in NGN above which admin approval is required)
LARGE_TRANSFER_THRESHOLD=1000000

# Admin seed (for seed:admin script)
ADMIN_PHONE=+2348000000000
ADMIN_PASSWORD=Admin@123

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Rate limit (throttle): ttl in ms, max requests per IP per ttl
THROTTLE_TTL=60000
THROTTLE_LIMIT=100